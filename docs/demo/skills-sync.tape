# skills-sync CLI + TUI demo for README
# Regenerate: ./scripts/record-demo.sh

Output docs/demo/skills-sync.gif

Set Shell zsh
Set FontSize 14
Set Width 1000
Set Height 560
Set Theme "Catppuccin Mocha"
Set TypingSpeed 45ms
Set Framerate 24
Set PlaybackSpeed 1.0

Hide
Type "cd $HOME/work && clear"
Enter
Show

Sleep 400ms

# --- CLI ---
Type "skills-sync status"
Enter
Sleep 1500ms

Type "skills-sync sync"
Enter
Sleep 2200ms

Type "skills-sync list"
Enter
Sleep 1800ms

# --- TUI ---
Type "skills-sync tui"
Enter
Sleep 2000ms

Down
Sleep 800ms
Down
Sleep 800ms
Up
Sleep 800ms

Type "s"
Sleep 2000ms

Type "q"
Sleep 600ms

Type "echo done"
Enter
Sleep 800ms
